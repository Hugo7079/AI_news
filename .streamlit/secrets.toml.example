# Streamlit Community Cloud 上「App settings → Secrets」貼這個內容
# 本機開發直接複製成 .streamlit/secrets.toml（已 gitignore），或設環境變數

# HuggingFace token（用於 og:image 失敗時呼叫 FLUX.1-schnell 生封面圖）
# 取得：https://huggingface.co/settings/tokens（建議 Read 權限即可）
HF_TOKEN = "hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 主分類 LLM（沿用 emap 共用，自行替換）
AINEWS_LLM_API_KEY = ""
AINEWS_LLM_BASE_URL = ""
AINEWS_LLM_MODEL = "gemma-4-31B-it"
