<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd 排程設定（每日 08:00 跑一次）
  安裝：
    cp com.leolee.ainews.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.leolee.ainews.plist
  停用：
    launchctl unload ~/Library/LaunchAgents/com.leolee.ainews.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.leolee.ainews</string>
 
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/leolee/AI新聞爬搜整理/run_daily.sh</string>
    </array>
 
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
 
    <key>WorkingDirectory</key>
    <string>/Users/leolee/AI新聞爬搜整理</string>
 
    <key>StandardOutPath</key>
    <string>/Users/leolee/AI新聞爬搜整理/output/launchd.out.log</string>
 
    <key>StandardErrorPath</key>
    <string>/Users/leolee/AI新聞爬搜整理/output/launchd.err.log</string>
 
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
