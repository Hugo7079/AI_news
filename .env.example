# 複製成 .env 後填入實際值：cp .env.example .env
# docker compose 會自動讀取（.env 已在 .gitignore）

# ── LLM（抽事件 / 分類 / 摘要） ──
AINEWS_LLM_API_KEY=
AINEWS_LLM_BASE_URL=https://llm-gateway.d8ai.ai/
AINEWS_LLM_MODEL=gemma-4-31B-it

# ── 封面生圖（gateway 上要是啟用中的模型） ──
AINEWS_IMAGE_MODEL=z-image-turbo
HF_TOKEN=

# ── 資料儲存：local（只寫本地）/ firestore / both ──
AINEWS_STORE=local

# ── 排程 ──
TZ=Asia/Taipei
AINEWS_RUN_AT=06:00
AINEWS_DAYS=1
AINEWS_ARGS=
AINEWS_RUN_ON_START=0

# ── 本地網站 ──
AINEWS_WEB_PORT=8080

# ── 只有 AINEWS_STORE=firestore / both 時才需要 ──
# 整份 service account JSON 貼成一行；或改用 compose 掛載 firebase-credentials.json
FIREBASE_SERVICE_ACCOUNT_JSON=
