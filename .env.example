# 複製成 .env 後填入實際值：cp .env.example .env
# docker compose 會自動讀取（.env 已在 .gitignore）
#
# 注意：純 python 執行（例如 scripts/*.py）不會讀這個檔 —— 它只給 docker compose 用。
# 本機直接跑腳本時，把金鑰放進 .ainews_llm_config.json 最方便（同樣已 gitignore，
# 而且設一次就好，不用每開一個終端機都重新 export）：
#
#   {
#     "api_key":       "<Mistral API key>",
#     "base_url":      "https://api.mistral.ai/v1",
#     "model":         "mistral-small-latest",
#     "cf_account_id": "<Cloudflare account id>",
#     "cf_api_token":  "<Workers AI token>"
#   }
#
# 優先序：環境變數 > .ainews_llm_config.json > 內建預設

# ── LLM（抽事件 / 分類 / 摘要）──
# 預設 Mistral La Plateforme（OpenAI 相容）。
# 免費 Experiment tier：1 RPS、500K TPM、每月 10 億 token。
# 本專案每天約 220 次呼叫 / 60 萬 token，一個月用掉約 2% 額度。
# d8ai gateway（litellm proxy，OpenAI 相容）。金鑰向內部索取。
AINEWS_LLM_API_KEY=
AINEWS_LLM_BASE_URL=https://llm-gateway.d8ai.ai/
AINEWS_LLM_MODEL=gemma-4-31B-it
# 全域速率上限（次/分）。gateway 沒有公開的硬限制，沿用 45 當保守值。
AINEWS_LLM_RPM=45

# ── 封面生圖 ──
# 預設 Cloudflare Workers AI 的 FLUX.1 [schnell]。
# 免費額度 10,000 neurons/天；1024×1024 / 4 steps 約 57.6 neurons 一張
# → 每天約 173 張，本專案每天約 68 張。
# account id 在 Cloudflare 主控台網址列，或「Workers & Pages」右側欄；
# API token 需要 "Workers AI: Read" 權限。
AINEWS_IMAGE_BACKEND=cloudflare
AINEWS_CF_ACCOUNT_ID=
AINEWS_CF_API_TOKEN=
AINEWS_CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
AINEWS_CF_IMAGE_STEPS=4

# 封面圖存放（選配）：Cloudflare R2
# 預設走 Firebase Storage —— 那需要 Blaze 方案，但用量在免費額度內、費用是 $0。
# 只有「不想開 Blaze」時才填下面這三個，填了 _upload_cover() 就自動改走 R2。
# 注意 R2 開通同樣需要付款方式，所以這不是「免綁卡」的解法。
# account id 沿用上面的 AINEWS_CF_ACCOUNT_ID；金鑰要另外建：
#   dash.cloudflare.com → R2 → Manage R2 API Tokens → Object Read & Write
#   （跟 Workers AI 那把不是同一把）
AINEWS_R2_ACCESS_KEY_ID=
AINEWS_R2_SECRET_ACCESS_KEY=
AINEWS_R2_BUCKET=ainews-covers
# bucket Settings → Public Development URL，或綁自訂網域
AINEWS_R2_PUBLIC_BASE=

# 封面後處理：裁成 16:9 並壓縮（1024×1024/485KB → 1024×576/約 68KB）
AINEWS_COVER_WIDTH=1024
AINEWS_COVER_QUALITY=82

# ── 資料儲存：local（只寫本地）/ firestore / both ──
AINEWS_STORE=local

# ── 排程 ──
TZ=Asia/Taipei
AINEWS_RUN_AT=06:00
AINEWS_DAYS=1
AINEWS_ARGS=
AINEWS_RUN_ON_START=0

# ── 本地網站 ──
AINEWS_WEB_PORT=8080
# 掛在反向代理的子路徑下才要填，例如 /morningledger（對外就是 https://host/morningledger/）
# 留空 = 掛在網域根目錄
AINEWS_BASE_PATH=

# ── 容器身分（不用 root）──
# 預設 10001；主機的 ./output 屬於別的 uid 時，用 `id -u` / `id -g` 填進來，
# 或把目錄改成對應擁有者：sudo chown -R 10001:10001 output
AINEWS_UID=10001
AINEWS_GID=10001

# ── 只有 AINEWS_STORE=firestore / both 時才需要 ──
# 整份 service account JSON 貼成一行；或改用 compose 掛載 firebase-credentials.json
FIREBASE_SERVICE_ACCOUNT_JSON=
