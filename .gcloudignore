# 上傳給 Cloud Build 的原始碼要排除的東西（跟 .dockerignore 同一套）
.gcloudignore
.git
.github
.claude
.clewline
.devcontainer
.firebase
__pycache__
**/__pycache__
*.pyc
.DS_Store
**/.DS_Store

# 金鑰與本機設定：絕對不要上傳
.env
deploy/*.env
!deploy/config.env
firebase-credentials.json
*-firebase-adminsdk-*.json
.ainews_llm_config.json

# 本機產出與大檔
output
*.tar
*.pdf
*.xlsx
web/_report_test.html
cron-trigger
